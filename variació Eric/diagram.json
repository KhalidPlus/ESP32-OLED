    [ "oled1:SDA", "esp:21", "green", [ "v-5", "h-30" ] ],
    [ "oled1:SCL", "esp:22", "blue", [ "v0", "h-20" ] ],
    [ "btn1:1.l", "esp:18", "orange", [ "h-30", "v-20" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h-40", "v30" ] ],
    [ "r1:1", "esp:3V3", "red", [ "h0", "v-60" ] ],
    [ "r1:2", "esp:18", "orange", [ "h0", "v10" ] ]
