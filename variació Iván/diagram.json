    [ "oled1:GND", "esp:GND.2", "black", [ "v-10", "h-90" ] ],
    [ "oled1:SDA", "esp:21", "green", [ "v-5", "h-30" ] ],
    [ "oled1:SCL", "esp:22", "blue", [ "v0", "h-20" ] ],
    [ "esp:19", "r1:1", "orange", [ "h20", "v10" ] ],
    [ "r1:2", "led1:A", "orange", [ "h10", "v-20" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v30", "h-60" ] ]
