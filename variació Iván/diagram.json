{
  "version": 1,
  "author": "Práctica ESP32 - V2 LED",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": -150, "left": 120, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led1", "top": 100, "left": 240, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 160, "left": 200, "attrs": { "value": "220" } }
